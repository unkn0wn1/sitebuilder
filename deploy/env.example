# Copy to the install directory as .env and fill in the values.
# The install script can write this for you: ./deploy/install.sh --dir /srv/sitebuilder

# 32 random bytes, base64. The installer generates one if you leave this empty.
# Back this up separately from the site backups. If it is lost, stored secrets must be re-entered.
SITEBUILDER_SECRET_KEY=

# The builder's public origin, for CSRF checks and Google OAuth redirects.
SITEBUILDER_ORIGIN=https://builder.example.org

# Hostnames nginx uses to tell the public site and the builder apart (same origin IP).
PUBLIC_HOST=example.org
BUILDER_HOST=builder.example.org

# Cloudflare Access in front of the builder hostname is required in production (ADR 0007).
SITEBUILDER_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
SITEBUILDER_ACCESS_AUD=

# Cloudflare zone, used to purge the public site by cache tag.
SITEBUILDER_CLOUDFLARE_ZONE_ID=

# Optional. Cloudflare API token, if not stored later as the cloudflare_token secret in Settings.
# SITEBUILDER_CLOUDFLARE_TOKEN=

# Off-site backups (S3-compatible: Cloudflare R2, Backblaze B2, AWS S3). The secret key is not stored in the backup.
# SITEBUILDER_BACKUP_S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
# SITEBUILDER_BACKUP_S3_BUCKET=sitebuilder-backups
# SITEBUILDER_BACKUP_S3_REGION=auto
# SITEBUILDER_BACKUP_S3_ACCESS_KEY_ID=
# SITEBUILDER_BACKUP_S3_SECRET_ACCESS_KEY=
# SITEBUILDER_BACKUP_S3_PREFIX=sitebuilder/

# Paths on the host (the installer sets these).
SITEBUILDER_DATA_DIR=/srv/sitebuilder/data
SITEBUILDER_MEDIA_HOST_DIR=/srv/sitebuilder/media
SITEBUILDER_SITE_DIR=/srv/sitebuilder/site
SITEBUILDER_ENV_FILE=/srv/sitebuilder/.env

# Optional. Use a published image instead of building locally.
# SITEBUILDER_IMAGE=sitebuilder:local

# SITEBUILDER_HTTP_PORT=80

# Optional. Off by default. Set to 1 to offer Sign in with xAI in Settings > AI.
# SITEBUILDER_ENABLE_XAI_OAUTH=1
# SITEBUILDER_XAI_OAUTH_CLIENT_ID=
