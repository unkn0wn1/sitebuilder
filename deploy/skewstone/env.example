# Copy to deploy/skewstone/.env on the machine that runs the demo. Do not commit that file.
# Generate the secret there: openssl rand -base64 32
# It is not a Cloudflare token, an AI key, or a mail password.
SITEBUILDER_SECRET_KEY=change-me
SITEBUILDER_ORIGIN=https://demo-admin.skewstone.com
SITEBUILDER_DEMO_MODE=1
SITEBUILDER_AGENT_GATEWAY=0
SITEBUILDER_DOCS_URL=https://docs.skewstone.com
SITEBUILDER_DEMO_ROOT=/var/lib/skewstone/demo
# Leave mail, AI keys, the Cloudflare Access audience, and the production Cloudflare token unset.
# Cloudflare Turnstile on the demo login. The secret lives only in this host .env, mode 600.
# Do not commit it. Leave both empty in the example. Do not set SITEBUILDER_TURNSTILE_DISABLED on the public demo.
SITEBUILDER_TURNSTILE_SITE_KEY=
SITEBUILDER_TURNSTILE_SECRET_KEY=
