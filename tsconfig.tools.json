{
  // Type-checks the seed script and unit tests, which sit outside Nuxt's own tsconfigs.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "paths": {
      "#shared": ["./shared"],
      "#shared/*": ["./shared/*"]
    }
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "vitest.*.ts", "shared/**/*.ts", "server/db/**/*.ts", "server/services/**/*.ts", "app/utils/**/*.ts", "playwright.config.ts"]
}
