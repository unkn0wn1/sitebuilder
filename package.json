{
  "name": "sitebuilder",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "agent-token": "tsx scripts/agent-token.ts",
    "agent-docs": "tsx scripts/agent-docs.ts",
    "test:api": "nuxt build && vitest run -c vitest.api.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:api",
    "restore": "tsx scripts/restore.ts",
    "install-site": "tsx scripts/install.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "flowbite-vue": "^0.4.0",
    "focus-trap": "^8.2.5",
    "jose": "^6.2.17",
    "nuxt": "^4.6.4",
    "sharp": "^0.35.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@vue/test-utils": "^2.6.0",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22"
  }
}
